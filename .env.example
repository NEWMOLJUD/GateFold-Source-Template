# Copy this file to .env and fill it in. The .env file is never committed.

# The address of your Gatefold.
GATEFOLD_URL=https://pages.example.com

# The alias of the source: the site is served at /reader/view/<alias>/.
GATEFOLD_SOURCE=handbook

# An administrator API key, created in the console under "API keys".
GATEFOLD_API_KEY=

# Optional.
# GATEFOLD_DIR=site
# GATEFOLD_PRUNE=true
# GATEFOLD_PUBLIC=false
